# ==============================================================================
# WebsiteTailors - Uploads Directory Protection
# Prevents execution of scripts in user-uploaded media directories
# ==============================================================================

# Disable directory indexing
Options -Indexes -ExecCGI

# Turn off PHP parsing inside uploads if mod_php is present
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Deny access to any executable scripts
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|pht|phar|cgi|pl|sh|bash|py|rb|asp|aspx|jsp)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
