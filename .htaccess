# ==============================================================================
# WebsiteTailors - Root Apache Configuration (.htaccess)
# Designed for production shared hosting (Hostinger, cPanel, Apache 2.4+)
# ==============================================================================

# Disable directory browsing
Options -Indexes

# Follow symbolic links
Options +FollowSymLinks

# Set default character set
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block access to hidden files and directories (e.g. .git, .env)
    RewriteRule (^|/)\.(?!well-known) - [F]

    # Block direct access to sensitive file extensions
    <FilesMatch "\.(sql|sqlite|sqlite3|db|log|ini|conf|bak|dist|sh|example)$">
        <IfModule mod_authz_core.c>
            Require all denied
        </IfModule>
        <IfModule !mod_authz_core.c>
            Order deny,allow
            Deny from all
        </IfModule>
    </FilesMatch>

    # Protect database and bin directories
    RewriteRule ^database/ - [F,L]
    RewriteRule ^bin/ - [F,L]

    # ----------------------------------------------------------------------
    # 1. CANONICAL HOST: 301 Redirect www.websitetailors.com to websitetailors.com
    # ----------------------------------------------------------------------
    RewriteCond %{HTTP_HOST} ^www\.websitetailors\.com$ [NC]
    RewriteRule ^(.*)$ https://websitetailors.com/$1 [R=301,L]

    # ----------------------------------------------------------------------
    # 2. CANONICAL HOMEPAGE: 301 Redirect /index.php to /
    # ----------------------------------------------------------------------
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index\.php[\s?] [NC]
    RewriteRule ^index\.php$ https://websitetailors.com/ [R=301,L]

    # ----------------------------------------------------------------------
    # 3. CANONICAL BLOG INDEX: 301 Redirect /blog/index.php to /blog/
    # ----------------------------------------------------------------------
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+blog/index\.php[\s?] [NC]
    RewriteRule ^blog/index\.php$ https://websitetailors.com/blog/ [R=301,L]

    # ----------------------------------------------------------------------
    # 4. CANONICAL PUBLIC ROUTES: 301 Redirect public .php to clean URLs
    #    - Applies only to safe GET and HEAD requests (preserves POST forms)
    #    - Excludes admin, api, database, bin, config, includes, tests, uploads
    #    - Excludes error documents (404.php, 500.php)
    #    - Checks THE_REQUEST to guarantee no redirect loops with internal rewrite
    # ----------------------------------------------------------------------
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
    RewriteCond %{REQUEST_URI} !^/(admin|api|database|bin|config|includes|tests|uploads)/ [NC]
    RewriteCond %{REQUEST_URI} !^/(404|500)\.php$ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+?)\.php[\s?] [NC]
    RewriteCond %{DOCUMENT_ROOT}/%1.php -f
    RewriteRule ^(.+?)\.php$ https://websitetailors.com/$1 [R=301,L]

    # ----------------------------------------------------------------------
    # 5. INTERNAL REWRITE: Map clean extensionless URLs to their .php files
    # ----------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.*)$ $1.php [L]
</IfModule>

# Custom User-Facing Error Documents
ErrorDocument 404 /404.php
ErrorDocument 500 /500.php

# Prevent viewing of sensitive files directly
<Files "error.log">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>

<Files "WebsiteTailors.sql">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>

<Files "WebsiteTailors.sqlite">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>

# Defensive HTTP Response Headers (if mod_headers is available)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compression of Text & Static Resources (mod_deflate)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    <IfModule mod_headers.c>
        Header append Vary Accept-Encoding
    </IfModule>
</IfModule>

# Browser Caching Policy (mod_expires & Cache-Control)
<IfModule mod_expires.c>
    ExpiresActive On
    # Dynamic HTML & API responses: Never cache (prevents CSRF token leakage and stale content)
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
    # Static Assets: Cache for 30 days
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType text/javascript "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# Granular Cache-Control Protection
<IfModule mod_headers.c>
    <FilesMatch "\.(php|html)$">
        Header set Cache-Control "private, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    <FilesMatch "\.(css|js|webp|jpg|jpeg|png|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
